kernel_build(
    name = "kernel_aarch64_tegra",
    srcs = ["//vendor/nvidia/kernel:kernel_aarch64_sources",],
    outs = [],
    arch = "arm64",

    # Enable mixed build.
    base_kernel = "//vendor/nvidia/kernel:kernel_aarch64",
    collect_unstripped_modules = True,
    defconfig = "//vendor/nvidia/kernel:arch/arm64/configs/gki_defconfig",
    keep_module_symvers = True,
    make_goals = [
        "modules",
    ],
    makefile = "//vendor/nvidia/kernel:Makefile",
    module_outs = _TEGRA_MODULES_LIST + _TEGRA_K618_MODULES_LIST,
    pre_defconfig_fragments = ["tegra.fragment"],
    strip_modules = True,
)

kernel_build(
    name = "kernel_aarch64_tegra_612",
    srcs = ["//vendor/nvidia/kernel:kernel_aarch64_sources",],
    outs = [],
    arch = "arm64",

    # Enable mixed build.
    base_kernel = "//vendor/nvidia/kernel:kernel_aarch64",
    collect_unstripped_modules = True,
    defconfig = "//vendor/nvidia/kernel:arch/arm64/configs/gki_defconfig",
    keep_module_symvers = True,
    make_goals = [
        "modules",
    ],
    makefile = "//vendor/nvidia/kernel:Makefile",
    module_outs = _TEGRA_MODULES_LIST + _TEGRA_K612_MODULES_LIST,
    pre_defconfig_fragments = ["tegra.fragment"],
    strip_modules = True,
)

alias(
    name = "kernel_tegra",
    actual = select({
        "kernel_612": ":kernel_aarch64_tegra_612",
        "//conditions:default": ":kernel_aarch64_tegra",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "kernel_tegra_headers",
    actual = select({
        "kernel_612": ":kernel_aarch64_tegra_612_headers",
        "//conditions:default": ":kernel_aarch64_tegra_headers",
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "kernel_tegra_uapi_headers",
    actual = select({
        "kernel_612": ":kernel_aarch64_tegra_612_uapi_headers",
        "//conditions:default": ":kernel_aarch64_tegra_uapi_headers",
    }),
)

kernel_module_group(
    name = "tegra_external_modules",
    srcs = [
        "//vendor/nvidia/lineage-oot:hid-nvidia-shield-oot",
        "//vendor/nvidia/lineage-oot:panel-jdi-58-1440-810",
        "//vendor/nvidia/lineage-oot:rm31080a_ctrl",
        "//vendor/nvidia/lineage-oot:rm31080a_ts",
        "//vendor/nvidia/lineage-oot:max77620-restart",
        "//vendor/nvidia/lineage-oot:snd-soc-es755",
    ],
)

kernel_modules_install(
    name = "tegra_modules_install",
    kernel_build = "//vendor/nvidia/kernel:kernel_aarch64",
    outs = [ "modules.dep", "modules.alias", ],
    kernel_modules = [
        ":tegra_external_modules",
    ],
)

pkg_files(
    name = "uapi_headers_dist_files",
    srcs = [
        "//vendor/nvidia/kernel:kernel_aarch64_uapi_headers",
    ],
    strip_prefix = strip_prefix.files_only(),
)
pkg_install(
    name = "tegra_uapi_headers_dist",
    srcs = [":tegra_uapi_headers_dist_files"],
    destdir = "out/tegra/dist",
)

pkg_files(
    name = "tegra_dist_files",
    srcs = [
        ":kernel_tegra",
        ":tegra_modules_install",
        ":uapi_headers_dist_files",
        "//vendor/nvidia/t18x-devicetrees:dtbs",
        "//vendor/nvidia/t18x-devicetrees:dtbos",
        "//vendor/nvidia/t18x-devicetrees:dtbo_image",
        "//vendor/nvidia/t18x-devicetrees:dtbo_verifications",
        "//vendor/nvidia/t19x-devicetrees:dtbs",
        "//vendor/nvidia/t19x-devicetrees:dtbos",
        "//vendor/nvidia/t19x-devicetrees:dtbo_image",
        "//vendor/nvidia/t19x-devicetrees:dtbo_verifications",
        "//vendor/nvidia/t21x-devicetrees:dtbs",
        "//vendor/nvidia/nx-devicetrees:dtbs",
        # Mixed build: Additional GKI artifacts.
        "//vendor/nvidia/kernel:kernel_aarch64",
        "//vendor/nvidia/kernel:kernel_aarch64_modules",
        "//vendor/nvidia/kernel:kernel_aarch64_system_dlkm_image",
    ],
    strip_prefix = strip_prefix.files_only(),
)
pkg_install(
    name = "tegra_dist",
    srcs = [":tegra_dist_files"],
    destdir = "out/tegra/dist",
)

kernel_abi(
    name = "tegra_abi",
    kernel_build = ":kernel_tegra",
    kernel_modules = [":tegra_external_modules"],
)
